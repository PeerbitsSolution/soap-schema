{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.peerbits.dev/soap-schema/v1/definitions/vitals.schema.json",
  "title": "Vitals",
  "description": "Vital sign measurements captured during an encounter. Every field is optional and independent — callers should include only the vitals actually captured; do not assume all are present.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bloodPressure": {
      "type": "object",
      "description": "Systolic/diastolic blood pressure.",
      "additionalProperties": false,
      "properties": {
        "systolic": { "$ref": "#/$defs/measurement" },
        "diastolic": { "$ref": "#/$defs/measurement" }
      }
    },
    "heartRate": { "$ref": "#/$defs/measurement" },
    "temperature": { "$ref": "#/$defs/measurement" },
    "respiratoryRate": { "$ref": "#/$defs/measurement" },
    "spo2": { "$ref": "#/$defs/measurement" },
    "height": { "$ref": "#/$defs/measurement" },
    "weight": { "$ref": "#/$defs/measurement" }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "description": "A single measured value with its unit. Unit is required so a bare number is never ambiguous (e.g. lb vs kg, F vs C).",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    }
  }
}
